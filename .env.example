# Site Next.js (Vercel)
# Même URL de projet que SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon / publique. Protégée par les policies RLS. Peut être exposée au navigateur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role. Serveur Next.js uniquement (lecture des commandes).
# Jamais dans un composant client, jamais préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Devise affichée (code ISO 4217). Défaut : EUR. À confirmer.
NEXT_PUBLIC_CURRENCY=

# Script de synchro (serveur Windows privé)
# Copier ces deux lignes dans sync/.env sur le serveur. Ne pas committer ce fichier.
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY est déjà listée ci-dessus : la même valeur sert au script.
